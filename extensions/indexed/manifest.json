{
  "manifest_version": 3,
  "name": "Flowsearch: is it indexed?",
  "version": "1.0.0",
  "description": "See on any website whether Flowsearch has it, how many of its pages are indexed, and jump to add or search it.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Is this site in Flowsearch?",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib.js", "background.js"]
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://*.trycloudflare.com/*"
  ],
  "browser_specific_settings": {
    "gecko": { "id": "flowsearch-indexed@luishae07", "strict_min_version": "127.0" }
  }
}
